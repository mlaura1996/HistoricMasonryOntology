    <rdf:type rdf:resource="https://w3id.org/hmo#Pattern"/>
    <rdfs:label xml:lang="en">Squared softstone pattern</rdfs:label>
    <rdfs:comment xml:lang="en">A type of pattern made of Squared Softstones, properly dressed.</rdfs:comment>
