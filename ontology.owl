  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b369">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#wl"/>
    <ns1:argument2 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#MQI"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#hasMasonryQualityIndex"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b99">
    <rdf:first rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b79"/>
    <rdf:rest rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b100"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#IrregularSoftstoneMasonry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/hmo#RepresentativeVolumeElement"/>
    <rdfs:label xml:lang="en">Irregular softstone masonry</rdfs:label>
    <rdfs:comment xml:lang="en">A type of masonry wall made irregular stones made of soft stone, such as tuff or calcarenite.</rdfs:comment>
    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#IrregularSoftstoneMasonryCompressiveStrength"/>
    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#IrregularSoftstoneMasonryMassDensity"/>
    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#IrregularSoftstoneMasonryShearModulus"/>
    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#IrregularSoftstoneMasonryShearStrength"/>
    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#IrregularSoftstoneMasonryYoungModulus"/>
    <hasPattern rdf:resource="https://w3id.org/hmo#IrregularSoftstonePattern"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b74">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>MQI_SD_PresenceOfMediumUnits</rdfs:label>
    <ns3:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns3:isRuleEnabled>
    <rdfs:comment>If a wall has a representative volume element which has a pattern which has a homogeneous pattern entity that are ‘units’, and the average length of the units is greater or equal than ‘20’ and less than ‘40’, then the value of MQI Unit Dimensions is equal to ‘0.5’ for vertical loads, ‘0.5’ for out of plane loads and ‘0.5’ for in plane loads.</rdfs:comment>
    <ns1:body rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b95"/>
    <ns1:head rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b105"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#MasonryLayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Masonry Layer</rdfs:label>
    <rdfs:comment xml:lang="en">A layer of a masonry wall.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#MasonryQualityIndex"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#MasonryWall"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#Pattern"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#PatternEntities"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#RepresentativeVolumeElement"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b928">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#Rpv"/>
    <ns1:argument2 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#MQI"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#hasMasonryQualityIndex"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b155">
    <rdf:first rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b132"/>
    <rdf:rest rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b156"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b857">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
    <ns1:arguments rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b858"/>
    <ns1:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#multiply"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b26">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b27"/>
    <rdf:rest rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b28"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b221">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#wl"/>
    <ns1:argument2 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#MQI"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#hasMasonryQualityIndex"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#CompressiveStrength">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Compressive Strength</rdfs:label>
    <rdfs:comment xml:lang="en">The average resistance of the homogenised material to breaking under compression.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/hmo#HomogenisedMechanicalProperty"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#MassDensity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#ShearModulus"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#ShearStrengthMC"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#ShearStrengthTC"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#TensileStrength"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#YoungModulus"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b266">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#wl"/>
    <ns1:argument2 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#RpV"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#hasRepresentativeVolumeElement"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b703">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <ns1:argument1 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#MQI"/>
    <ns1:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.5</ns1:argument2>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#MQIUnitsShapeVert"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b535">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#float">40.0</rdf:first>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#MQITotalInPlane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Masonry Quality Index total value for in plane loads</rdfs:label>
    <rdfs:comment xml:lang="en">Defines the total value of MQI for in plane loads</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/hmo#MasonryQualityIndex"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#RubbleStones">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/hmo#Units"/>
    <rdfs:label xml:lang="en">Rubble stones</rdfs:label>
    <rdfs:comment xml:lang="en">Irregular stones such as pebbles, erratic and irregular stones.</rdfs:comment>
    <areDominantPatternEntitiesOf rdf:resource="https://w3id.org/hmo#IrregularStonePattern"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b547">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <ns1:argument1 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#MQI"/>
    <ns1:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.0</ns1:argument2>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#MQIUnitsDimensionsVert"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b960">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <ns1:argument1 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#MQI"/>
    <ns1:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#float">2.0</ns1:argument2>
