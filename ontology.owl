  <rdf:Description rdf:about="https://w3id.org/hmo#IrregularSoftstoneMasonryCompressiveStrength">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/hmo#CompressiveStrength"/>
    <rdfs:label xml:lang="en">Irregular softstone masonry compressive strength</rdfs:label>
    <ns2:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.8</ns2:hasValue>
    <ns2:isMeasuredIn rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b192">
