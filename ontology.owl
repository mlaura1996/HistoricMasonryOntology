  <rdf:Description rdf:about="https://w3id.org/hmo#MasonryWall">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Masonry Wall</rdfs:label>
    <rdfs:comment xml:lang="en">A load bearing wall made of structural masorny.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://pi.pauwel.be/voc/buildingelement#Wall"/>
    <owl:disjointWith rdf:resource="https://w3id.org/hmo#Pattern"/>
