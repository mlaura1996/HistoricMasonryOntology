  <rdf:Description rdf:about="https://w3id.org/hmo#SquaredHardstoneMasonryMassDensity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/hmo#MassDensity"/>
    <rdfs:label xml:lang="en">Squared hardstone masonry mass density</rdfs:label>
    <ns2:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">22.0</ns2:hasValue>
    <ns2:isMeasuredIn rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre"/>
  </rdf:Description>
