  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b583">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>MQI_MM_RomanCementMortar</rdfs:label>
    <ns3:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns3:isRuleEnabled>
    <rdfs:comment>If a wall has a representative volume element which has a pattern which has dominant pattern entities ‘roman cement mortar’, then the value of MQI Mortar Quality is equal to ‘2’ for vertical loads, ‘1’ for out of plane loads and ‘1’ for in plane loads.</rdfs:comment>
    <ns1:body rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b588"/>
    <ns1:head rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b592"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b226">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b227"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#hasHomogenisedMechanicalProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has homogenised mechanical property</rdfs:label>
    <rdfs:comment xml:lang="en">Defines the relationship between a representative volume element and an homogenised mechanical property.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/hmo#RepresentativeVolumeElement"/>
    <rdfs:range rdf:resource="https://w3id.org/hmo#HomogenisedMechanicalProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/hmo#isHomogenisedMechanicalPropertyOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#MQIHorizontalJointsVert">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">MQI-Vertical-Horizontal Joints</rdfs:label>
    <rdfs:comment xml:lang="en">Defines the adequacy of horizontal joints (based on level of horizontality/continuity), in the context of vertical loading.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/hmo#MasonryQualityIndex"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#HollowBrickMasonryShearModulus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/hmo#ShearModulus"/>
    <rdfs:label xml:lang="en">Hollow brick masonry shear modulus</rdfs:label>
    <ns2:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1138.0</ns2:hasValue>
    <ns2:isMeasuredIn rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal"/>
  </rdf:Description>
