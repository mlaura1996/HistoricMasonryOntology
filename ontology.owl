    <hasDominantPatternEntities rdf:resource="https://w3id.org/hmo#PartiallyStaggeredJoints"/>
    <hasDominantPatternEntities rdf:resource="https://w3id.org/hmo#SquaredSoftstone"/>
  </rdf:Description>
