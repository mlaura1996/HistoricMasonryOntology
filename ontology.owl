    <ns1:classPredicate rdf:resource="https://w3id.org/hmo#RepresentativeVolumeElement"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b690">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <ns1:argument1 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#MQI"/>
    <ns1:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</ns1:argument2>
