    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <ns1:argument1 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#MQI"/>
    <ns1:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.7</ns1:argument2>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#MQIUnitsPropertiesOutOfPlane"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b948">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>MQI_SS_SquaredSoftStone</rdfs:label>
    <ns3:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns3:isRuleEnabled>
    <rdfs:comment>If a wall has a representative volume element which has a pattern which has a homogeneous pattern entity that is ‘squared soft stones’, then the value of MQI Unit Shape is equal to ‘3’ for vertical loads, ‘2’ for out of plane loads and ‘2’ for in plane loads.</rdfs:comment>
    <ns1:body rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b949"/>
    <ns1:head rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b957"/>
  </rdf:Description>
