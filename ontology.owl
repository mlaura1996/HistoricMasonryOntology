    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#SquaredSoftstoneMasonryShearStrength"/>
    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#SquaredSoftstoneMasonryYoungModulus"/>
    <hasPattern rdf:resource="https://w3id.org/hmo#SquaredSoftstonePattern"/>
  </rdf:Description>
