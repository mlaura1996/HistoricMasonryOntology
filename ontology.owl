    <rdfs:label xml:lang="en">are sparse pattern entities of</rdfs:label>
    <rdfs:comment xml:lang="en">It determines when a pattern entity is'sparse'in a pattern, i.e. when it has a distribution of less than 50 per cent in the pattern. </rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/hmo#PatternEntities"/>
    <rdfs:range rdf:resource="https://w3id.org/hmo#Pattern"/>
