  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b462">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>MQI_VJ_PartiallyStaggeredJoints</rdfs:label>
    <ns3:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns3:isRuleEnabled>
    <rdfs:comment>If a wall has a representative volume element which has a pattern which has a homogeneous pattern entity that are ‘propertly staggered units’, then the value of MQI vertical joints is equal to ‘0.5’ for vertical loads, ‘1’ for out of plane loads and ‘0.5’ for in plane loads.</rdfs:comment>
    <ns1:body rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b467"/>
    <ns1:head rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b471"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b64">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#Pttr"/>
    <ns1:argument2 rdf:resource="https://w3id.org/hmo#BarelyCutStone"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#hasDominantPatternEntities"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b502">
