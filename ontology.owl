  <rdf:Description rdf:about="https://w3id.org/hmo#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:creator>Maria Laura Leonardi, Stefano Cursi, Elena Gigliarelli, José Granja, Daniel Oliveira, Miguel Azenha.</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology to represent the historic masonry material</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-02</dcterms:issued>
    <dcterms:license>https://creativecommons.org/licenses/by/1.0</dcterms:license>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</dcterms:modified>
    <dcterms:title xml:lang="en">Historic Masonry Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>hmo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/hmo#</vann:preferredNamespaceUri>
    <rdfs:comment xml:lang="en">Version 0.3: IrregularSoftstone sets the unit material only, and dry joints have a mortar score; see CHANGELOG.md.</rdfs:comment>
    <owl:priorVersion rdf:resource="https://w3id.org/hmo/0.2"/>
    <owl:versionIRI rdf:resource="https://w3id.org/hmo/0.3"/>
    <owl:versionInfo>0.3</owl:versionInfo>
  </rdf:Description>
