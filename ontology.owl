  <rdf:Description rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b324">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>MQI_SM_HollowBricks_LessEqualThan55_GreaterEqualThan30</rdfs:label>
    <ns3:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns3:isRuleEnabled>
    <rdfs:comment>If a wall has a representative volume element which has a pattern which has dominant pattern entities (hollow bricks) that have a pergentage of volume equal or greater than 30% and less or equal than 55 % then the value of MQI Unit Properties is equal to ‘0.7’ for vertical loads, ‘0.7’ for out of plane loads and ‘0.7’ for in plane loads.</rdfs:comment>
    <ns1:body rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b336"/>
    <ns1:head rdf:nodeID="n0abc1605ede544e1ab8c45503b83a543b343"/>
  </rdf:Description>
