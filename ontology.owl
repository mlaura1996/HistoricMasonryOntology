    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#SquaredHardstoneMasonryCompressiveStrength"/>
    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#SquaredHardstoneMasonryMassDensity"/>
    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#SquaredHardstoneMasonryShearModulus"/>
    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#SquaredHardstoneMasonryShearStrength"/>
    <hasHomogenisedMechanicalProperty rdf:resource="https://w3id.org/hmo#SquaredHardstoneMasonryYoungModulus"/>
    <hasPattern rdf:resource="https://w3id.org/hmo#SquaredHardstonePattern"/>
  </rdf:Description>
