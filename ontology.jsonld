      "https://w3id.org/hmo#Units"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Hard stone units that are not squared (irregular or roughly cut), such as limestone or sandstone rubble. Sets the unit material only; the unit shape is given by its own pattern entity."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Irregular hardstone"
      }
    ]
  },
