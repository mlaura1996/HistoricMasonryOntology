        "@value": true
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "If a wall has a representative volume element which has a pattern which has dominant pattern entities (hollow bricks) that have a pergentage of volume equal or greater than 30% and less or equal than 55 % then the value of MQI Unit Properties is equal to ‘0.7’ for vertical loads, ‘0.7’ for out of plane loads and ‘0.7’ for in plane loads."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MQI_SM_HollowBricks_LessEqualThan55_GreaterEqualThan30"
      }
    ],
