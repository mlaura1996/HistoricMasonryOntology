    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "If a wall has a representative volume element which has a pattern which has a homogeneous pattern entity that are ‘units’, and the average length of the units is greater or equal than ‘20’ and less than ‘40’, then the value of MQI Unit Dimensions is equal to ‘0.5’ for vertical loads, ‘0.5’ for out of plane loads and ‘0.5’ for in plane loads."
      }
    ],
