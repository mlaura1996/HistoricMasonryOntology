[] a ns1:Imp ;
    rdfs:label "MQI_InPlane" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "Evaluation of masonry quality index for in plane" ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIiP> ;
                    ns1:classPredicate :MasonryQualityIndex ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIiP> ;
                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#HJiP> ;
                            ns1:propertyPredicate :MQIHorizontalJointsInPlane ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIiP> ;
                                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#VJiP> ;
                                    ns1:propertyPredicate :MQIVerticalJointsInPlane ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIiP> ;
                                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MMiP> ;
                                            ns1:propertyPredicate :MQIMortarQualityInPlane ] ;
                                    rdf:rest [ a ns1:AtomList ;
                                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIiP> ;
                                                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#SSiP> ;
                                                    ns1:propertyPredicate :MQIUnitsShapeInPlane ] ;
                                            rdf:rest [ a ns1:AtomList ;
                                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIiP> ;
                                                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#WCiP> ;
                                                            ns1:propertyPredicate :MQIWallLeavesConnectionsInPlane ] ;
                                                    rdf:rest [ a ns1:AtomList ;
                                                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIiP> ;
                                                                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#SDiP> ;
                                                                    ns1:propertyPredicate :MQIUnitsDimensionsInPlane ] ;
                                                            rdf:rest [ a ns1:AtomList ;
                                                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIiP> ;
                                                                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#SMiP> ;
                                                                            ns1:propertyPredicate :MQIUnitsPropertiesInPlane ] ;
                                                                    rdf:rest [ a ns1:AtomList ;
                                                                            rdf:first [ a ns1:BuiltinAtom ;
                                                                                    ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#sum> <http://www.semanticweb.org/owl/owlapi/turtle#HJiP> <http://www.semanticweb.org/owl/owlapi/turtle#VJiP> <http://www.semanticweb.org/owl/owlapi/turtle#MMiP> <http://www.semanticweb.org/owl/owlapi/turtle#SSiP> <http://www.semanticweb.org/owl/owlapi/turtle#WCiP> <http://www.semanticweb.org/owl/owlapi/turtle#SDiP> ) ;
                                                                                    ns1:builtin <http://www.w3.org/2003/11/swrlb#add> ] ;
                                                                            rdf:rest [ a ns1:AtomList ;
                                                                                    rdf:first [ a ns1:BuiltinAtom ;
                                                                                            ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#mlt> <http://www.semanticweb.org/owl/owlapi/turtle#sum> <http://www.semanticweb.org/owl/owlapi/turtle#SMiP> ) ;
                                                                                            ns1:builtin <http://www.w3.org/2003/11/swrlb#multiply> ] ;
                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIiP> ;
                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#mlt> ;
                    ns1:propertyPredicate :MQITotalInPlane ] ;
            rdf:rest () ] .

