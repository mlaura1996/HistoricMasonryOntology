@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/11/swrl#> .
@prefix ns2: <https://saref.etsi.org/core/> .
@prefix ns3: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://bimerr.iot.linkeddata.es/def/material-properties#Material> a owl:Class ;
    rdfs:label "Material"@en ;
    rdfs:comment "imported from http://bimerr.iot.linkeddata.es/def/material-properties ; used to describe eterogeneous materials."@en ;
    owl:equivalentClass :RepresentativeVolumeElement .

<http://bimerr.iot.linkeddata.es/def/material-properties#hasMaterial> a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .

ns3:isRuleEnabled a owl:AnnotationProperty .

<http://www.semanticweb.org/owl/owlapi/turtle#HJoP> a ns1:Variable .

xsd:date a rdfs:Datatype .

xsd:maxInclusive a rdfs:Datatype .

xsd:minInclusive a rdfs:Datatype .

foaf:Person a owl:Class .

foaf:name a owl:AnnotationProperty .

ns2:isMeasuredIn a owl:DatatypeProperty .

: a owl:Ontology ;
    dcterms:creator "Maria Laura Leonardi, Stefano Cursi, Elena Gigliarelli, José Granja, Daniel Oliveira, Miguel Azenha." ;
    dcterms:description "Ontology to represent the historic masonry material"@en ;
    dcterms:issued "2024-04-02"^^xsd:date ;
    dcterms:license "https://creativecommons.org/licenses/by/1.0" ;
    dcterms:modified "2024-04-02"^^xsd:date ;
    dcterms:title "Historic Masonry Ontology"@en ;
    vann:preferredNamespacePrefix "hmo" ;
    vann:preferredNamespaceUri "https://w3id.org/hmo#" ;
    rdfs:comment "Version 0.1"@en ;
    owl:versionIRI <https://w3id.org/hmo/0.1> ;
    owl:versionInfo "0.1" .

:BarelyCutStoneMasonry a owl:NamedIndividual,
        :RepresentativeVolumeElement ;
    rdfs:label "Barely cut stone masonry"@en ;
    rdfs:comment "A type of masonry wall made of barely cut stones, properly dressed."@en ;
    :hasHomogenisedMechanicalProperty :BarelyCutStoneMasonryCompressiveStrength,
        :BarelyCutStoneMasonryMassDensity,
        :BarelyCutStoneMasonryShearModulus,
        :BarelyCutStoneMasonryShearStrength,
        :BarelyCutStoneMasonryYoungModulus ;
    :hasPattern :BarelyCutStonePattern .

:Brickwork a owl:NamedIndividual,
        :RepresentativeVolumeElement ;
    rdfs:label "Brickwork"@en ;
    rdfs:comment "A type of masonry wall made of solid clay bricks."@en ;
    :hasHomogenisedMechanicalProperty :BrickworkCompressiveStrength,
        :BrickworkMassDensity,
        :BrickworkShearModulus,
        :BrickworkShearStrengthMC,
        :BrickworkShearStrengthTC,
        :BrickworkYoungModulus ;
    :hasPattern :BricksPattern .

:HollowBrickMasonry a owl:NamedIndividual,
        :RepresentativeVolumeElement ;
    rdfs:label "Hollow brick masonry"@en ;
    rdfs:comment "Lightly perforated clay brick masonry (volume of all holes ≤ 40%), with cement-lime mortar."@en ;
    :hasHomogenisedMechanicalProperty :HollowBrickMasonryCompressiveStrength,
        :HollowBrickMasonryMassDensity,
        :HollowBrickMasonryShearModulus,
        :HollowBrickMasonryShearStrength,
        :HollowBrickMasonryYoungModulus ;
    :hasPattern :HollowBrickPattern .

:HollowBrickMasonryShearStrengthMC a owl:NamedIndividual,
        :ShearStrengthMC ;
    rdfs:label "Hollow brick masonry shear strength (Mohr Coulomb)"@en ;
    ns2:hasValue "0.14"^^xsd:float ;
    ns2:isMeasuredIn <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:IrregularSoftstoneMasonry a owl:NamedIndividual,
        :RepresentativeVolumeElement ;
    rdfs:label "Irregular softstone masonry"@en ;
    rdfs:comment "A type of masonry wall made irregular stones made of soft stone, such as tuff or calcarenite."@en ;
    :hasHomogenisedMechanicalProperty :IrregularSoftstoneMasonryCompressiveStrength,
        :IrregularSoftstoneMasonryMassDensity,
        :IrregularSoftstoneMasonryShearModulus,
        :IrregularSoftstoneMasonryShearStrength,
        :IrregularSoftstoneMasonryYoungModulus ;
    :hasPattern :IrregularSoftstonePattern .

:IrregularStoneMasonry a owl:NamedIndividual,
        :RepresentativeVolumeElement ;
    rdfs:label "Irregular stone masonry"@en ;
    rdfs:comment "A type of masonry wall made of irregular stones such as pebbles, erratic and irregular stones."@en ;
    :hasHomogenisedMechanicalProperty :IrregularStoneMasonryCompressiveStrength,
        :IrregularStoneMasonryMassDensity,
        :IrregularStoneMasonryShearModulus,
        :IrregularStoneMasonryShearStrength,
        :IrregularStoneMasonryYoungModulus ;
    :hasPattern :IrregularStonePattern .

:RoughlyCutStoneMasonry a owl:NamedIndividual,
        :RepresentativeVolumeElement ;
    rdfs:label "Roughly Cut Stone Masonry"@en ;
    rdfs:comment "Roughly dressed stone masonry, with wythes of irregular thickness."@en ;
    :hasHomogenisedMechanicalProperty :RoughlyCutStoneMasonryCompressiveStrength,
        :RoughlyCutStoneMasonryMassDensity,
        :RoughlyCutStoneMasonryShearModulus,
        :RoughlyCutStoneMasonryShearStrength,
        :RoughlyCutStoneMasonryYoungModulus ;
    :hasPattern :RoughlyCutStonePattern .

:SquaredHardstoneMasonry a owl:NamedIndividual,
        :RepresentativeVolumeElement ;
    rdfs:label "Squared hardstone masonry"@en ;
    rdfs:comment "A type of masonry wall made of regular blocks of hardstone."@en ;
    :hasHomogenisedMechanicalProperty :SquaredHardstoneMasonryCompressiveStrength,
        :SquaredHardstoneMasonryMassDensity,
        :SquaredHardstoneMasonryShearModulus,
        :SquaredHardstoneMasonryShearStrength,
        :SquaredHardstoneMasonryYoungModulus ;
    :hasPattern :SquaredHardstonePattern .

:SquaredSoftstoneMasonry a owl:NamedIndividual,
        :RepresentativeVolumeElement ;
    rdfs:label "Squared Softstone Masonry"@en ;
    rdfs:comment "A type of regular masonry wall made of cut, soft stones, such as tuff or calcarenite."@en ;
    :hasHomogenisedMechanicalProperty :SquaredSoftstoneMasonryCompressiveStrength,
        :SquaredSoftstoneMasonryMassDensity,
        :SquaredSoftstoneMasonryShearModulus,
        :SquaredSoftstoneMasonryShearStrength,
        :SquaredSoftstoneMasonryYoungModulus ;
    :hasPattern :SquaredSoftstonePattern .

:areDominantPatternEntitiesOf a owl:ObjectProperty ;
    rdfs:label "are dominant pattern entities of"@en ;
    rdfs:comment "It determines when a pattern entity is 'dominant' in a pattern, i.e. when it has a distribution greater than 50% in the pattern."@en ;
    rdfs:domain :PatternEntities ;
    rdfs:range :Pattern ;
    owl:inverseOf :hasDominantPatternEntities .

:areInterfaceElementsOf a owl:ObjectProperty ;
    rdfs:label "are interface elements of"@en ;
    rdfs:comment "Defines the relationship between joints and units in a pattern."@en ;
    rdfs:domain :Joints ;
    rdfs:range :Units ;
    owl:inverseOf :hasInterfaceElements .

:areSparsePatternEntitiesOf a owl:ObjectProperty ;
    rdfs:label "are sparse pattern entities of"@en ;
    rdfs:comment "It determines when a pattern entity is'sparse'in a pattern, i.e. when it has a distribution of less than 50 per cent in the pattern. "@en ;
    rdfs:domain :PatternEntities ;
    rdfs:range :Pattern ;
    owl:inverseOf :hasSparsePatternEntities .

:hasMasonryLayer a owl:ObjectProperty ;
    rdfs:label "has layer"@en ;
    rdfs:comment "Defines the relationship between a masonry wall and a masonry layer."@en ;
    rdfs:domain :MasonryWall ;
    rdfs:range :MasonryLayer ;
    owl:inverseOf :isMasonryLayerOf .

:isLocatedIn a owl:ObjectProperty ;
    rdfs:label "is located of"@en ;
    rdfs:comment "Defines the Masonry Layer where a pattern is located."@en ;
    rdfs:domain :Pattern ;
    rdfs:range :MasonryLayer .

:jointsThickness a owl:DatatypeProperty ;
    rdfs:label "Joint Thickness"@en ;
    rdfs:comment "Defines the thickness of the joints. "@en ;
    rdfs:domain :Units ;
    rdfs:range xsd:float .

:unitsHeightHasMaximumValue a owl:DatatypeProperty ;
    rdfs:label "Units Height Has Maximum Value"@en ;
    rdfs:comment "Defines the maximum value of the height of the units in the pattern. "@en ;
    rdfs:domain :Units ;
    rdfs:range xsd:float .

:unitsHeigthHasMinimumValue a owl:DatatypeProperty ;
    rdfs:label "Units Height Has Minimum Value"@en ;
    rdfs:comment "Defines the minimum value of the height of the units in the pattern. "@en ;
    rdfs:domain :Units ;
    rdfs:range xsd:float .

<http://bimerr.iot.linkeddata.es/def/material-properties#Property> a owl:Class .

<http://www.semanticweb.org/owl/owlapi/turtle#dmg> a ns1:Variable .

<https://w3id.org/dot#DamageArea> a owl:Class ;
    rdfs:label "Damage Area"@en ;
    rdfs:comment "imported from https://w3id.org/dot ; used to describe damage in hmo:PatternEntities"@en .

<https://w3id.org/dot/hasDamageArea> a owl:ObjectProperty ;
    rdfs:domain :PatternEntities ;
    rdfs:range <https://w3id.org/dot#DamageArea> .

