[] a ns1:Imp ;
    rdfs:label "MQI_SS_BarelyCutStone" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "If a wall has a representative volume element which has a pattern which has a homogeneous pattern entity that is ‘barely cut stones, then the value of MQI Unit Shape is equal to ‘3’ for vertical loads, ‘2’ for out of plane loads and ‘2’ for in plane loads." ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                    ns1:propertyPredicate :hasRepresentativeVolumeElement ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:IndividualPropertyAtom ;
                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                            ns1:propertyPredicate :hasPattern ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:IndividualPropertyAtom ;
                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                                    ns1:argument2 :BarelyCutStone ;
                                    ns1:propertyPredicate :hasDominantPatternEntities ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:IndividualPropertyAtom ;
                                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                                            ns1:propertyPredicate :hasMasonryQualityIndex ] ;
                                    rdf:rest () ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                    ns1:argument2 "3.0"^^xsd:float ;
                    ns1:propertyPredicate :MQIUnitsShapeVert ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                            ns1:argument2 "2.0"^^xsd:float ;
                            ns1:propertyPredicate :MQIUnitsShapeOutOfPlane ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                                    ns1:argument2 "2.0"^^xsd:float ;
                                    ns1:propertyPredicate :MQIUnitsShapeInPlane ] ;
                            rdf:rest () ] ] ] .

[] a ns1:Imp ;
    rdfs:label "ShearStrengthMQI" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "Evaluation of the shear strength from MQI" ;
    ns1:body ( [ a ns1:ClassAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:classPredicate :RepresentativeVolumeElement ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:propertyPredicate :hasRepresentativeVolumeElement ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:propertyPredicate :hasMasonryQualityIndex ] [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQIi> ;
                ns1:propertyPredicate :MQITotalInPlane ] [ a ns1:ClassAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Sst> ;
                ns1:classPredicate :ShearStrengthTC ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#Sst> ;
                ns1:propertyPredicate :hasHomogenisedMechanicalProperty ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#MQIisq> <http://www.semanticweb.org/owl/owlapi/turtle#MQIi> "2.0"^^xsd:float ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#pow> ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#factor1> <http://www.semanticweb.org/owl/owlapi/turtle#MQIisq> "0.0005"^^xsd:float ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#multiply> ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#factor2> <http://www.semanticweb.org/owl/owlapi/turtle#MQIi> "0.0074"^^xsd:float ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#multiply> ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#S> <http://www.semanticweb.org/owl/owlapi/turtle#factor1> <http://www.semanticweb.org/owl/owlapi/turtle#factor2> "0.0192"^^xsd:float ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#add> ] ) ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Sst> ;
                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#S> ;
                    ns1:propertyPredicate ns2:hasValue ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
