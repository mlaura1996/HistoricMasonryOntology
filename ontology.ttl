[] a ns1:Imp ;
    rdfs:label "MQI_SM_HollowBricks_LessEqualThan55_GreaterEqualThan30" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "If a wall has a representative volume element which has a pattern which has dominant pattern entities (hollow bricks) that have a pergentage of volume equal or greater than 30% and less or equal than 55 % then the value of MQI Unit Properties is equal to ‘0.7’ for vertical loads, ‘0.7’ for out of plane loads and ‘0.7’ for in plane loads." ;
    ns1:body ( [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:propertyPredicate :hasRepresentativeVolumeElement ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                ns1:propertyPredicate :hasPattern ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#brk> ;
                ns1:propertyPredicate :hasDominantPatternEntities ] [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#brk> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#vlm> ;
                ns1:propertyPredicate :bricksHaveVolumePercentage ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#vlm> "0.3"^^xsd:float ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#vlm> "0.55"^^xsd:float ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#lessThanOrEqual> ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:propertyPredicate :hasMasonryQualityIndex ] ) ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                    ns1:argument2 "0.7"^^xsd:float ;
                    ns1:propertyPredicate :MQIUnitsPropertiesVert ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                            ns1:argument2 "0.7"^^xsd:float ;
                            ns1:propertyPredicate :MQIUnitsPropertiesInPlane ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                                    ns1:argument2 "0.7"^^xsd:float ;
                                    ns1:propertyPredicate :MQIUnitsPropertiesOutOfPlane ] ;
                            rdf:rest () ] ] ] .

