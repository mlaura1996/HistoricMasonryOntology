[] a ns1:Imp ;
    rdfs:label "MQI_SD_PresenceOfLittleUnits" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "If a wall has a representative volume element which has a pattern which has a homogeneous pattern entity that are ‘units’, and the average length of the units is less than ‘20’, then the value of MQI Unit Dimensions is equal to ‘0’ for vertical loads, ‘0’ for out of plane loads and ‘0’ for in plane loads." ;
    ns1:body ( [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:propertyPredicate :hasRepresentativeVolumeElement ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                ns1:propertyPredicate :hasPattern ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#unt> ;
                ns1:propertyPredicate :hasDominantPatternEntities ] [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#unt> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#minVal> ;
                ns1:propertyPredicate :unitsLengthHasMinimumValue ] [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#unt> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#maxVal> ;
                ns1:propertyPredicate :unitsLengthMaximumValue ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#sum> <http://www.semanticweb.org/owl/owlapi/turtle#minVal> <http://www.semanticweb.org/owl/owlapi/turtle#maxVal> ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#add> ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#avg> <http://www.semanticweb.org/owl/owlapi/turtle#sum> "2.0"^^xsd:float ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#divide> ] [ a ns1:BuiltinAtom ;
                ns1:arguments [ a rdf:List ;
                        rdf:first <http://www.semanticweb.org/owl/owlapi/turtle#avg> ;
                        rdf:rest [ a rdf:List ;
                                rdf:first "20.0"^^xsd:float ;
                                rdf:rest () ] ] ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#lessThan> ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:propertyPredicate :hasMasonryQualityIndex ] ) ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                    ns1:argument2 "0.0"^^xsd:float ;
                    ns1:propertyPredicate :MQIUnitsDimensionsVert ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                            ns1:argument2 "0.0"^^xsd:float ;
                            ns1:propertyPredicate :MQIUnitsDimensionsOutOfPlane ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                                    ns1:argument2 "0.0"^^xsd:float ;
                                    ns1:propertyPredicate :MQIUnitsDimensionsInPlane ] ;
                            rdf:rest () ] ] ] .

