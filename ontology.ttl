[] a ns1:Imp ;
    rdfs:label "YoungModulusMQI" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "Evaluation of the young modulus from MQI" ;
    ns1:body ( [ a ns1:ClassAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:classPredicate :RepresentativeVolumeElement ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:propertyPredicate :hasRepresentativeVolumeElement ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:propertyPredicate :hasMasonryQualityIndex ] [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQIv> ;
                ns1:propertyPredicate :MQITotalVertical ] [ a ns1:ClassAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Y> ;
                ns1:classPredicate :YoungModulus ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#Y> ;
                ns1:propertyPredicate :hasHomogenisedMechanicalProperty ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#factor1> <http://www.semanticweb.org/owl/owlapi/turtle#MQIv> "0.1381"^^xsd:float ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#multiply> ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#factor2> "2.72"^^xsd:float <http://www.semanticweb.org/owl/owlapi/turtle#factor1> ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#pow> ] [ a ns1:BuiltinAtom ;
                ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#YM> "814.06"^^xsd:float <http://www.semanticweb.org/owl/owlapi/turtle#factor2> ) ;
                ns1:builtin <http://www.w3.org/2003/11/swrlb#multiply> ] ) ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Y> ;
                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#YM> ;
                    ns1:propertyPredicate ns2:hasValue ] ;
            rdf:rest () ] .

[] a ns1:AtomList .

