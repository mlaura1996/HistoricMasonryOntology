    rdfs:comment "If a wall has a representative volume element which has a pattern which has a homogeneous pattern entity that is ‘squared soft stones’, then the value of MQI Unit Shape is equal to ‘3’ for vertical loads, ‘2’ for out of plane loads and ‘2’ for in plane loads." ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                    ns1:propertyPredicate :hasRepresentativeVolumeElement ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:IndividualPropertyAtom ;
                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                            ns1:propertyPredicate :hasPattern ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:IndividualPropertyAtom ;
                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                                    ns1:argument2 :SquaredSoftstone ;
                                    ns1:propertyPredicate :hasDominantPatternEntities ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:IndividualPropertyAtom ;
                                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                                            ns1:propertyPredicate :hasMasonryQualityIndex ] ;
                                    rdf:rest () ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                    ns1:argument2 "3.0"^^xsd:float ;
                    ns1:propertyPredicate :MQIUnitsShapeVert ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                            ns1:argument2 "2.0"^^xsd:float ;
                            ns1:propertyPredicate :MQIUnitsShapeOutOfPlane ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                                    ns1:argument2 "2.0"^^xsd:float ;
                                    ns1:propertyPredicate :MQIUnitsShapeInPlane ] ;
                            rdf:rest () ] ] ] .

[] a ns1:AtomList .

[] a ns1:Imp ;
    rdfs:label "MQI_VJ_VerticallyAlignedJoints" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "If a wall has a representative volume element which has a pattern which has a homogeneous pattern entity that are ‘vertically aligned units’, then the value of MQI vertical joints is equal to ‘0’ for vertical loads, ‘0’ for out of plane loads and ‘0’ for in plane loads." ;
    ns1:body ( [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:propertyPredicate :hasRepresentativeVolumeElement ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                ns1:propertyPredicate :hasPattern ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                ns1:argument2 :VerticallyAlignedJoints ;
                ns1:propertyPredicate :hasDominantPatternEntities ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:propertyPredicate :hasMasonryQualityIndex ] ) ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                    ns1:argument2 "0.0"^^xsd:float ;
                    ns1:propertyPredicate :MQIVerticalJointsVert ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                            ns1:argument2 "0.0"^^xsd:float ;
                            ns1:propertyPredicate :MQIVerticalJointsInPlane ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                                    ns1:argument2 "0.0"^^xsd:float ;
                                    ns1:propertyPredicate :MQIVerticalJointsOutOfPlane ] ;
                            rdf:rest () ] ] ] .

