:VerticallyAlignedJoints a owl:NamedIndividual,
        :VerticalJoints ;
    rdfs:label "Vertically aligned joints"@en ;
    rdfs:comment "Vertical joints that are aligned in the pattern."@en .

:hasInterfaceElements a owl:ObjectProperty ;
    rdfs:label "has interface elements"@en ;
    rdfs:comment "Defines the relationship between units and joints in a pattern."@en ;
    rdfs:domain :Units ;
    rdfs:range :Joints .

:isHomogenisedMechanicalPropertyOf a owl:ObjectProperty ;
    rdfs:label "is homogenised mechanical property of"@en ;
    rdfs:comment "Defines the relationship between an homogenised mechanical property and a masonry wall."@en ;
    rdfs:domain :HomogenisedMechanicalProperty ;
    rdfs:range :MasonryWall .

:isMasonryLayerOf a owl:ObjectProperty ;
    rdfs:label "is layer of"@en ;
    rdfs:comment "Defines the relationship between a masonry wall and a masonry layer."@en ;
    rdfs:domain :MasonryLayer ;
    rdfs:range <https://pi.pauwel.be/voc/buildingelement#Wall> .

:isPatternOf a owl:ObjectProperty ;
    rdfs:label "is pattern of"@en ;
    rdfs:comment "Used to define when one or more patterns are present in a Representative Volume Element."@en ;
    rdfs:domain :Pattern ;
    rdfs:range :RepresentativeVolumeElement .

