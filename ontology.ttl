<https://pi.pauwel.be/voc/buildingelement#Wall> a owl:Class .

:BarelyCutStone a owl:NamedIndividual,
        :Units ;
    rdfs:label "Barely cut stones"@en ;
    rdfs:comment "Barely cut stones."@en ;
    :areDominantPatternEntitiesOf :BarelyCutStonePattern .

:BarelyCutStonePattern a owl:NamedIndividual,
        :Pattern ;
    rdfs:label "Barely cut stone pattern"@en ;
    rdfs:comment "A type of pattern made of barely cut stones, properly dressed."@en ;
    :hasDominantPatternEntities :BarelyCutStone,
        :ContinuousHorizontalJoints,
        :ProperlyStaggeredJoints .

:BricksPattern a owl:NamedIndividual,
        :Pattern ;
    rdfs:label "Bricks Pattern"@en ;
    rdfs:comment "A type of pattern made of bricks, properly dressed."@en ;
    :hasDominantPatternEntities :Bricks,
        :ContinuousHorizontalJoints,
        :LimeMortarJoints,
        :ProperlyStaggeredJoints .

:DryJoints a owl:NamedIndividual,
        :Joints ;
    rdfs:label "Dry joints"@en ;
    rdfs:comment "Dry joints, with no mortar."@en .

:HeadersBondUnits a owl:NamedIndividual,
        :Units ;
    rdfs:label "Headers bond units"@en ;
    rdfs:comment "Headers are units which are places has headers (shorter face) in the face of the wall."@en .

:HollowBrickPattern a owl:NamedIndividual,
        :Pattern ;
    rdfs:label "HollowBrick Pattern"@en ;
    rdfs:comment "Lightly perforated clay brick masonry pattern (volume of all holes ≤ 40%), with cement-lime mortar."@en ;
    :hasDominantPatternEntities :CementLimeMortarJoints,
        :ContinuousHorizontalJoints,
        :HollowBricks,
        :ProperlyStaggeredJoints .

:HollowBricks a owl:NamedIndividual,
        :Units ;
    :areDominantPatternEntitiesOf :HollowBrickPattern ;
    :bricksHaveVolumePercentage 0.6 .

:IrregularSoftstonePattern a owl:NamedIndividual,
        :Pattern ;
    rdfs:label "Irregular softstone pattern"@en ;
    rdfs:comment "A type of pattern made of irregular softstones, properly dressed."@en ;
    :hasDominantPatternEntities :IrregularSoftstone,
        :NotContinuousHorizontalJoints,
        :PartiallyStaggeredJoints .

:IrregularStonePattern a owl:NamedIndividual,
        :Pattern ;
    rdfs:label "Irregular Stone Pattern"@en ;
    rdfs:comment "A type of pattern made of irregular stones such as pebbles, erratic and irregular stones."@en ;
    :hasDominantPatternEntities :NotContinuousHorizontalJoints,
        :PartiallyStaggeredJoints,
        :RubbleStones .

:LimeMortarJoints a owl:NamedIndividual,
        :MortarJoints ;
    rdfs:label "Lime mortar joints"@en .

:PartiallyContinuousHorizontalJoints a owl:NamedIndividual,
        :HorizontalJoints ;
    rdfs:label "Partially continuous horizontal joints"@en ;
    rdfs:comment "Horizontal joints that are not continuous along the entire pattern, but just in some part of it."@en .

:RoughlyCutStone a owl:NamedIndividual,
        :Units ;
    rdfs:label "Roughly Cut Stones"@en ;
    rdfs:comment "Roughly cut stones of different thicknesses."@en ;
    :areDominantPatternEntitiesOf :RoughlyCutStonePattern .

:RoughlyCutStonePattern a owl:NamedIndividual,
        :Pattern ;
    rdfs:label "Roughly cut stone pattern"@en ;
    rdfs:comment "A type of pattern made of roughly dressed stone masonry, with wythes of irregular thickness "@en ;
    :hasDominantPatternEntities :PartiallyContinuousHorizontalJoints,
        :PartiallyStaggeredJoints,
        :RoughlyCutStone .

:SquaredHardstonePattern a owl:NamedIndividual,
        :Pattern ;
    rdfs:label "Squared Hardstone Pattern"@en ;
    rdfs:comment "A type of pattern made of squared hardstones, properly dressed."@en ;
    :hasDominantPatternEntities :NotContinuousHorizontalJoints,
        :ProperlyStaggeredJoints,
        :SquaredHardstone .

:SquaredSoftstonePattern a owl:NamedIndividual,
        :Pattern ;
    rdfs:label "Squared softstone pattern"@en ;
    rdfs:comment "A type of pattern made of Squared Softstones, properly dressed."@en ;
    :hasDominantPatternEntities :NotContinuousHorizontalJoints,
        :PartiallyStaggeredJoints,
        :SquaredSoftstone .

:hasSparsePatternEntities a owl:ObjectProperty ;
    rdfs:label "has sparse pattern entities"@en ;
    rdfs:comment "Determines which pattern entities are sparse in a pattern."@en ;
    rdfs:domain :Pattern ;
    rdfs:range :PatternEntities .

<http://www.semanticweb.org/owl/owlapi/turtle#C> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#Sst> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#Y> a ns1:Variable .

:Bricks a owl:NamedIndividual,
        :Units ;
    rdfs:label "Bricks"@en ;
    rdfs:comment "Solid clay bricks."@en ;
    :areDominantPatternEntitiesOf :BricksPattern .

:HorizontalJoints a owl:Class ;
    rdfs:label "Horizontal Joints"@en ;
    rdfs:comment "Horizontal spaces between masonry units. Can be either dry or made of mortar."@en ;
    rdfs:subClassOf :Joints ;
    owl:disjointWith :VerticalJoints .

:IrregularSoftstone a owl:NamedIndividual,
        :Units ;
    rdfs:label "Irregular softstone"@en ;
    rdfs:comment "Irregular stones made of soft stone, such as tuff or calcarenite."@en ;
    :areDominantPatternEntitiesOf :IrregularSoftstonePattern .

:MQITotalInPlane a owl:DatatypeProperty ;
    rdfs:label "Masonry Quality Index total value for in plane loads"@en ;
    rdfs:comment "Defines the total value of MQI for in plane loads"@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQITotalVertical a owl:DatatypeProperty ;
    rdfs:label "Masonry Quality Index total value for vertical loads"@en ;
    rdfs:comment "Defines the total value of MQI for vertical loads"@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:SquaredHardstone a owl:NamedIndividual,
        :Units ;
    rdfs:label "Squared hardstone"@en ;
    rdfs:comment "Squared hard stones/ashlar."@en ;
    :areDominantPatternEntitiesOf :SquaredHardstonePattern .

:SquaredSoftstone a owl:NamedIndividual,
        :Units ;
    rdfs:label "Squared Softstone"@en ;
    rdfs:comment "Squared soft stones such as tuff or calcarenite."@en ;
    :areDominantPatternEntitiesOf :SquaredSoftstonePattern .

:bricksHaveVolumePercentage a owl:DatatypeProperty ;
    rdfs:label "Bricks have volume percentage"@en ;
    rdfs:comment "In hollow bricks, it defines the percentage of volume, espressed in decimal (eg: 0.4 for 40%). "@en ;
    rdfs:domain :Units ;
    rdfs:range xsd:decimal .

:unitsLengthHasMinimumValue a owl:DatatypeProperty ;
    rdfs:label "Units Length Has Minimum Value"@en ;
    rdfs:comment "Defines the minimum value of the length of the units in the pattern. "@en ;
    rdfs:domain :Units ;
    rdfs:range xsd:float .

:unitsLengthMaximumValue a owl:DatatypeProperty ;
    rdfs:label "Units Length Has Maximum Value"@en ;
    rdfs:comment "Defines the maximum value of the length of the units in the pattern. "@en ;
    rdfs:domain :Units ;
    rdfs:range xsd:float .

<http://www.semanticweb.org/owl/owlapi/turtle#Rpv> a ns1:Variable .

ns2:hasValue a owl:DatatypeProperty .

:ContinuousHorizontalJoints a owl:NamedIndividual,
        :HorizontalJoints ;
    rdfs:label "Continuous horizontal joints"@en ;
    rdfs:comment "Horizontal joints that are continuous along the entire pattern."@en .

:MQIHorizontalJointsInPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-In Plane-Horizontal Joints"@en ;
    rdfs:comment "Defines the adequacy of horizontal joints (based on level of horizontality/continuity), in the context of in plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIHorizontalJointsOutOfPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-Out Of Plane-Horizontal Joints"@en ;
    rdfs:comment "Defines the adequacy of horizontal joints (based on level of horizontality/continuity), in the context of out of plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIHorizontalJointsVert a owl:DatatypeProperty ;
    rdfs:label "MQI-Vertical-Horizontal Joints"@en ;
    rdfs:comment "Defines the adequacy of horizontal joints (based on level of horizontality/continuity), in the context of vertical loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIUnitsDimensionsInPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-In Plane-Units Dimensions"@en ;
    rdfs:comment "Defines the adequacy of units size, in the context of in plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIUnitsDimensionsOutOfPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-Out Of Plane-Units Dimensions"@en ;
    rdfs:comment "Defines the adequacy of units size, in the context of out of plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIUnitsDimensionsVert a owl:DatatypeProperty ;
    rdfs:label "MQI-Vertical-Units Dimensions"@en ;
    rdfs:comment "Defines the adequacy of units size, in the context of vertical loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MasonryLayer a owl:Class ;
    rdfs:label "Masonry Layer"@en ;
    rdfs:comment "A layer of a masonry wall."@en ;
    owl:disjointWith :MasonryQualityIndex,
        :MasonryWall,
        :Pattern,
        :PatternEntities,
        :RepresentativeVolumeElement .

:VerticalJoints a owl:Class ;
    rdfs:label "Vertical Joints"@en ;
    rdfs:comment "Vertical spaces between masonry units. Can be either dry or made of mortar."@en ;
    rdfs:subClassOf :Joints .

:hasHomogenisedMechanicalProperty a owl:ObjectProperty ;
    rdfs:label "has homogenised mechanical property"@en ;
    rdfs:comment "Defines the relationship between a representative volume element and an homogenised mechanical property."@en ;
    rdfs:domain :RepresentativeVolumeElement ;
    rdfs:range :HomogenisedMechanicalProperty ;
    owl:inverseOf :isHomogenisedMechanicalPropertyOf .

<http://www.semanticweb.org/owl/owlapi/turtle#MQIi> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#S> a ns1:Variable .

:MQIMortarQualityInPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-In Plane-Mortar Quality"@en ;
    rdfs:comment "Defines the adequacy of the mortar, in the context of in plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIMortarQualityOutOfPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-Out Of Plane-Mortar Quality"@en ;
    rdfs:comment "Defines the adequacy of the mortar, in the context of out of plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIMortarQualityVert a owl:DatatypeProperty ;
    rdfs:label "MQI-Vertical-Mortar Quality"@en ;
    rdfs:comment "Defines the adequacy of the mortar, in the context of vertical loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIWallLeavesConnectionsInPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-In Plane-Wall Leaves Connection"@en ;
    rdfs:comment "Defines the adequacy of connections of the adjacent leaves in a wall, in the context of in plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIWallLeavesConnectionsOutOfPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-Out Of Plane-Wall Leaves Connection"@en ;
    rdfs:comment "Defines the adequacy of connections of the adjacent leaves in a wall, in the context of out of plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIWallLeavesConnectionsVert a owl:DatatypeProperty ;
    rdfs:label "MQI-Vertical-Wall Leaves Connection"@en ;
    rdfs:comment "Defines the adequacy of connections of the adjacent leaves in a wall, in the context of vertical loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MortarJoints a owl:Class ;
    rdfs:label "Mortar Joints"@en ;
    rdfs:comment "Joints made of mortar."@en ;
    rdfs:subClassOf :Joints .

:NotContinuousHorizontalJoints a owl:NamedIndividual,
        :HorizontalJoints ;
    rdfs:label "Non continuous horizontal joints"@en ;
    rdfs:comment "Horizontal joints that are not continuous along the entire pattern."@en .

:PartiallyStaggeredJoints a owl:NamedIndividual,
        :VerticalJoints ;
    rdfs:label "Partially staggered joints"@en ;
    rdfs:comment "Vertical joints that are partially misaligned in the pattern."@en .

:ProperlyStaggeredJoints a owl:NamedIndividual,
        :VerticalJoints ;
    rdfs:label "Properly Staggered Joints"@en ;
    rdfs:comment "Vertical joints that are properly misaligned in the pattern."@en .

:RubbleStones a owl:NamedIndividual,
        :Units ;
    rdfs:label "Rubble stones"@en ;
    rdfs:comment "Irregular stones such as pebbles, erratic and irregular stones."@en ;
    :areDominantPatternEntitiesOf :IrregularStonePattern .

:TensileStrength a owl:Class ;
    rdfs:label "Tensile Strength"@en ;
    rdfs:comment "The average resistance of the homogenised material to breaking under tension."@en ;
    rdfs:subClassOf :HomogenisedMechanicalProperty ;
    owl:disjointWith :YoungModulus .

<http://www.semanticweb.org/owl/owlapi/turtle#brk> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#maxVal> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#minVal> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#mlt> a ns1:Variable .

:Joints a owl:Class ;
    rdfs:label "Joints"@en ;
    rdfs:comment "The configuration of the joints in the pattern."@en ;
    rdfs:subClassOf :PatternEntities ;
    owl:disjointWith :Units .

:MQIVerticalJointsInPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-In Plane-Vertical Joints"@en ;
    rdfs:comment "Defines the adequacy of In plane joints (based on staggered properties), in the context of in plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIVerticalJointsOutOfPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-Out Of Plane-Vertical Joints"@en ;
    rdfs:comment "Defines the adequacy of Out of plane joints (based on staggered properties), in the context of out of plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIVerticalJointsVert a owl:DatatypeProperty ;
    rdfs:label "MQI-Vertical-Vertical Joints"@en ;
    rdfs:comment "Defines the adequacy of vertical joints (based on staggered properties), in the context of vertical loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

<http://www.semanticweb.org/owl/owlapi/turtle#avg> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#vlm> a ns1:Variable .

:MasonryWall a owl:Class ;
    rdfs:label "Masonry Wall"@en ;
    rdfs:comment "A load bearing wall made of structural masorny."@en ;
    rdfs:subClassOf <https://pi.pauwel.be/voc/buildingelement#Wall> ;
    owl:disjointWith :Pattern,
        :PatternEntities .

:ShearStrengthMC a owl:Class ;
    rdfs:label "Shear Strength (Mohr Coulomb)"@en ;
    rdfs:comment "Average shear strength according to the Mohr-Coulomb criterion. It is used in the case of regular-textured masonry and corresponds to diagonal tensile failure at the joints level."@en ;
    rdfs:subClassOf :HomogenisedMechanicalProperty ;
    owl:disjointWith :ShearStrengthTC,
        :TensileStrength,
        :YoungModulus .

<http://www.semanticweb.org/owl/owlapi/turtle#factor1> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#factor2> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#MQIiP> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#MQIoP> a ns1:Variable .

:CompressiveStrength a owl:Class ;
    rdfs:label "Compressive Strength"@en ;
    rdfs:comment "The average resistance of the homogenised material to breaking under compression."@en ;
    rdfs:subClassOf :HomogenisedMechanicalProperty ;
    owl:disjointWith :MassDensity,
        :ShearModulus,
        :ShearStrengthMC,
        :ShearStrengthTC,
        :TensileStrength,
        :YoungModulus .

:HomogenisedMechanicalProperty a owl:Class ;
    rdfs:label "Homogenised Mechanical Property"@en ;
    rdfs:comment "A mechanical property associated to an entire masonry wall, considering the assembly of units and joints."@en ;
    rdfs:subClassOf <http://bimerr.iot.linkeddata.es/def/material-properties#Property> ;
    owl:disjointWith :MasonryLayer,
        :MasonryQualityIndex,
        :MasonryWall,
        :Pattern,
        :PatternEntities,
        :RepresentativeVolumeElement,
        :Units .

:MQIUnitsPropertiesInPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-In Plane-Units Properties"@en ;
    rdfs:comment "Defines the adequacy of mechanical properties of the units, in the context of in plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIUnitsPropertiesOutOfPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-Out Of Plane-Units Properties"@en ;
    rdfs:comment "Defines the adequacy of mechanical properties of the units, in the context of out of plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIUnitsPropertiesVert a owl:DatatypeProperty ;
    rdfs:label "MQI-Vertical-Units Properties"@en ;
    rdfs:comment "Defines the adequacy of mechanical properties of the units, in the context of vertical loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MassDensity a owl:Class ;
    rdfs:label "Mass Density"@en ;
    rdfs:comment "The mass per unit volume of a masonry wall."@en ;
    rdfs:subClassOf :HomogenisedMechanicalProperty ;
    owl:disjointWith :ShearModulus,
        :ShearStrengthMC,
        :ShearStrengthTC,
        :TensileStrength,
        :YoungModulus .

:MQIUnitsShapeInPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-In Plane-Units Shape"@en ;
    rdfs:comment "Defines the adequacy of the units shape, in the context of in plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIUnitsShapeOutOfPlane a owl:DatatypeProperty ;
    rdfs:label "MQI-Out Of Plane-Units Shape"@en ;
    rdfs:comment "Defines the adequacy of the units shape, in the context of out of plane loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:MQIUnitsShapeVert a owl:DatatypeProperty ;
    rdfs:label "MQI-Vertical-Units Shape"@en ;
    rdfs:comment "Defines the adequacy of the units shape, in the context of vertical loading."@en ;
    rdfs:domain :MasonryQualityIndex ;
    rdfs:range xsd:float .

:ShearStrengthTC a owl:Class ;
    rdfs:label "Shear Strength (Turnsek and Cacovic)"@en ;
    rdfs:comment "Average shear strength according to the Turnsek and Cacovic criterion. It is used in the case of irregular-textured masonry and corresponds to diagonal tensile failure at the masonry level."@en ;
    rdfs:subClassOf :HomogenisedMechanicalProperty ;
    owl:disjointWith :TensileStrength,
        :YoungModulus .

<http://www.semanticweb.org/owl/owlapi/turtle#unt> a ns1:Variable .

:ShearModulus a owl:Class ;
    rdfs:label "Shear Modulus"@en ;
    rdfs:comment "Modulus of tangential elasticity."@en ;
    rdfs:subClassOf :HomogenisedMechanicalProperty ;
    owl:disjointWith :ShearStrengthMC,
        :ShearStrengthTC,
        :TensileStrength,
        :YoungModulus .

<http://www.semanticweb.org/owl/owlapi/turtle#sum> a ns1:Variable .

:PatternEntities a owl:Class ;
    rdfs:label "Pattern Entities"@en ;
    rdfs:comment "A group of entities in a pattern which have the same function, geometry and material properties."@en .

<http://www.semanticweb.org/owl/owlapi/turtle#MQIv> a ns1:Variable .

:YoungModulus a owl:Class ;
    rdfs:label "Young Modulus"@en ;
    rdfs:comment "Modulus of longitudinal elasticity."@en ;
    rdfs:subClassOf :HomogenisedMechanicalProperty .

:Pattern a owl:Class ;
    rdfs:label "Pattern"@en ;
    rdfs:comment "The pattern formed by units and joints in a masonry layer."@en ;
    owl:disjointWith :PatternEntities,
        :RepresentativeVolumeElement .

:RepresentativeVolumeElement a owl:Class ;
    rdfs:label "Representative Volume Element"@en ;
    rdfs:comment "In the context of global macro-models, a masonry area to which homogeneous mechanical characteristics can be attributed."@en .

:Units a owl:Class ;
    rdfs:label "Units"@en ;
    rdfs:comment "The configuration of the units in the pattern."@en ;
    rdfs:subClassOf :PatternEntities .

:MasonryQualityIndex a owl:Class ;
    rdfs:label "Masonry Quality Index"@en ;
    rdfs:comment "A visual method for assessing the structural behavior of masonry walls."@en ;
    owl:disjointWith :MasonryWall,
        :Pattern,
        :PatternEntities,
        :RepresentativeVolumeElement .

:hasPattern a owl:ObjectProperty ;
    rdfs:label "has pattern"@en ;
    rdfs:comment "Defines the relationship between a representative volume elements and a pattern."@en ;
    rdfs:domain :RepresentativeVolumeElement ;
    rdfs:range :Pattern ;
    owl:inverseOf :isPatternOf .

:hasDominantPatternEntities a owl:ObjectProperty ;
    rdfs:label "has dominant pattern entities"@en ;
    rdfs:comment "Determines which pattern entities are dominant (more than 50%) in a pattern."@en ;
    rdfs:domain :Pattern ;
    rdfs:range :PatternEntities .

:hasRepresentativeVolumeElement a owl:ObjectProperty ;
    rdfs:label "has representative volume element"@en ;
    rdfs:comment "Defines the representative volume element of a wall"@en ;
    rdfs:domain :MasonryWall ;
    rdfs:range :RepresentativeVolumeElement .

:hasMasonryQualityIndex a owl:ObjectProperty ;
    rdfs:label "has Masonry Quality Index"@en ;
    rdfs:comment "Defines the Masonry Quality Index associated with a wall"@en ;
    rdfs:domain :MasonryWall ;
    rdfs:range :MasonryQualityIndex .

<http://www.semanticweb.org/owl/owlapi/turtle#Pttr> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#wl> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#RpV> a ns1:Variable .

<http://www.semanticweb.org/owl/owlapi/turtle#MQI> a ns1:Variable .

[] a ns1:Imp ;
    rdfs:label "MQI_WC_NoHeaders" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "Wall leaves connection score when no headers are present and the masonry is not rubble stone." ;
    ns1:body ( [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:propertyPredicate :hasRepresentativeVolumeElement ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                ns1:propertyPredicate :hasPattern ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                ns1:argument2 :NoHeaders ;
                ns1:propertyPredicate :hasDominantPatternEntities ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:propertyPredicate :hasMasonryQualityIndex ] ) ;
    ns1:head ( [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:argument2 "0.0"^^xsd:float ;
                ns1:propertyPredicate :MQIWallLeavesConnectionsVert ] [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:argument2 "0.0"^^xsd:float ;
                ns1:propertyPredicate :MQIWallLeavesConnectionsOutOfPlane ] [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:argument2 "0.0"^^xsd:float ;
                ns1:propertyPredicate :MQIWallLeavesConnectionsInPlane ] ) .

[] a ns1:Imp ;
    rdfs:label "MQI_SM_SquaredSoftStone" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "Unit material score for soft stone (tuff, calcarenite) when the units are squared; the same score as the irregular soft-stone rule, since the material is the same." ;
    ns1:body ( [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:propertyPredicate :hasRepresentativeVolumeElement ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#RpV> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                ns1:propertyPredicate :hasPattern ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#Pttr> ;
                ns1:argument2 :SquaredSoftstone ;
                ns1:propertyPredicate :hasDominantPatternEntities ] [ a ns1:IndividualPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#wl> ;
                ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:propertyPredicate :hasMasonryQualityIndex ] ) ;
    ns1:head ( [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:argument2 "0.7"^^xsd:float ;
                ns1:propertyPredicate :MQIUnitsPropertiesVert ] [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:argument2 "0.7"^^xsd:float ;
                ns1:propertyPredicate :MQIUnitsPropertiesInPlane ] [ a ns1:DatavaluedPropertyAtom ;
                ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQI> ;
                ns1:argument2 "0.7"^^xsd:float ;
                ns1:propertyPredicate :MQIUnitsPropertiesOutOfPlane ] ) .

