[] a ns1:Imp ;
    rdfs:label "MQI_OutOfPlane" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "Evaluation of masonry quality index for the out of plane" ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIoP> ;
                    ns1:classPredicate :MasonryQualityIndex ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIoP> ;
                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#HoP> ;
                            ns1:propertyPredicate :MQIHorizontalJointsOutOfPlane ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIoP> ;
                                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#VJoP> ;
                                    ns1:propertyPredicate :MQIVerticalJointsOutOfPlane ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIoP> ;
                                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#MMoP> ;
                                            ns1:propertyPredicate :MQIMortarQualityOutOfPlane ] ;
                                    rdf:rest [ a ns1:AtomList ;
                                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIoP> ;
                                                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#SSoP> ;
                                                    ns1:propertyPredicate :MQIUnitsShapeOutOfPlane ] ;
                                            rdf:rest [ a ns1:AtomList ;
                                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIoP> ;
                                                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#WCoP> ;
                                                            ns1:propertyPredicate :MQIWallLeavesConnectionsOutOfPlane ] ;
                                                    rdf:rest [ a ns1:AtomList ;
                                                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIoP> ;
                                                                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#SDoP> ;
                                                                    ns1:propertyPredicate :MQIUnitsDimensionsOutOfPlane ] ;
                                                            rdf:rest [ a ns1:AtomList ;
                                                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                                            ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIoP> ;
                                                                            ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#SMoP> ;
                                                                            ns1:propertyPredicate :MQIUnitsPropertiesOutOfPlane ] ;
                                                                    rdf:rest [ a ns1:AtomList ;
                                                                            rdf:first [ a ns1:BuiltinAtom ;
                                                                                    ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#sum> <http://www.semanticweb.org/owl/owlapi/turtle#HoP> <http://www.semanticweb.org/owl/owlapi/turtle#VJoP> <http://www.semanticweb.org/owl/owlapi/turtle#MMoP> <http://www.semanticweb.org/owl/owlapi/turtle#SSoP> <http://www.semanticweb.org/owl/owlapi/turtle#WCoP> <http://www.semanticweb.org/owl/owlapi/turtle#SDoP> ) ;
                                                                                    ns1:builtin <http://www.w3.org/2003/11/swrlb#add> ] ;
                                                                            rdf:rest [ a ns1:AtomList ;
                                                                                    rdf:first [ a ns1:BuiltinAtom ;
                                                                                            ns1:arguments ( <http://www.semanticweb.org/owl/owlapi/turtle#mlt> <http://www.semanticweb.org/owl/owlapi/turtle#sum> <http://www.semanticweb.org/owl/owlapi/turtle#SMoP> ) ;
                                                                                            ns1:builtin <http://www.w3.org/2003/11/swrlb#multiply> ] ;
                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <http://www.semanticweb.org/owl/owlapi/turtle#MQIoP> ;
                    ns1:argument2 <http://www.semanticweb.org/owl/owlapi/turtle#mlt> ;
                    ns1:propertyPredicate :MQITotalOutOfPlane ] ;
            rdf:rest () ] .

